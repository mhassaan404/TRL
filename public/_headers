# Netlify response headers for every page of the app (copied to the build root by Vite).
#   no framing by other sites (clickjacking), no MIME sniffing, the address is not sent to other sites,
#   and browser features the app never uses are switched off.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files have their content in the name (index-AbC123.js), so a changed file always gets a new name: browsers
# may keep them for good and never re-check, which makes repeat visits fast on slow connections. index.html is not
# cached this way, so a new deploy is picked up on the next visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
