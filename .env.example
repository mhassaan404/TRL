# Copy to .env.local (development) or .env.production.local (production build) and adjust.
# Vite only exposes variables that start with VITE_. These values end up in the built JavaScript,
# so never put secrets here.
# Development: the local API. Production: leave it unset (the app then calls /api on its own site, which
# Netlify forwards to the API server - public/_redirects). Don't point a production build at another site's
# address: browsers that block third-party cookies would then log users out right after login.
VITE_API_BASE_URL=https://localhost:7295/api
